# Modelo de configuração do back-end.
# COPIE (não renomeie) este arquivo para `.env` e preencha os valores:
#   copy .env.example .env
# O `.env` real é ignorado pelo git — a senha nunca vai para o repositório.

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bom_preco

# Porta em que a API REST vai escutar
PORT=3000
