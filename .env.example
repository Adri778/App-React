# Modelo de configuração do aplicativo (Expo / React Native).
# COPIE (não renomeie) este arquivo para `.env` e ajuste os endereços:
#   copy .env.example .env
# O `.env` real é ignorado pelo git.
#
# ATENÇÃO: variáveis com o prefixo EXPO_PUBLIC_ são embutidas no pacote do
# aplicativo e podem ser lidas por quem tiver o APK. Use somente para
# endereços e configurações públicas — nunca para senha, token ou chave.

# Endereço da API REST do back-end
#   Emulador Android ....... http://10.0.2.2:3000/api
#   Dispositivo físico ..... http://SEU-IP-NA-REDE:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Página web de cadastro de produto, aberta dentro do app
EXPO_PUBLIC_ADMIN_URL=http://10.0.2.2:5173/admin/produtos/novo
